---
const currentPath = Astro.url.pathname;

const links = [
  { href: "/admin/menu", label: "Menú" },
  { href: "/admin/settings", label: "Configuración" },
  { href: "/admin/orders", label: "Pedidos" },
];
---

<header class="bg-white border-b border-gray-200 px-6 py-4">
  <div class="flex items-center justify-between max-w-7xl mx-auto">
    <a href="/admin/menu" class="text-xl font-bold text-gray-900">FootStep</a>
    <nav class="flex items-center gap-4 text-sm">
      {links.map((link) => (
        <a
          href={link.href}
          class={currentPath.startsWith(link.href)
            ? "text-orange-600 font-medium"
            : "text-gray-600 hover:text-gray-900"}
        >
          {link.label}
        </a>
      ))}
      <button
        id="logout-btn"
        class="ml-4 px-3 py-1.5 text-sm text-red-600 border border-red-200 rounded-md hover:bg-red-50 transition-colors"
      >
        Cerrar sesión
      </button>
    </nav>
  </div>
</header>

<script>
  document.getElementById("logout-btn")?.addEventListener("click", () => {
    localStorage.removeItem("footstep_access_token");
    localStorage.removeItem("footstep_refresh_token");
    window.location.href = "/admin/login";
  });
</script>
