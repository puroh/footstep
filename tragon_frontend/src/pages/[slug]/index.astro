---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PublicMenu from "@/components/PublicMenu";

const { slug } = Astro.params;
const API_BASE = import.meta.env.PUBLIC_API_BASE ?? "http://backend:8000/api/v1";

// Fetch restaurant public info
const restaurantRes = await fetch(`${API_BASE}/restaurants/${slug}/public/`);
if (!restaurantRes.ok) {
  return Astro.redirect("/404");
}
const restaurant = await restaurantRes.json();

// Fetch public menu
const menuRes = await fetch(`${API_BASE}/catalog/${slug}/menu/`);
if (!menuRes.ok) {
  return Astro.redirect("/404");
}
const menuData = await menuRes.json();
---

<BaseLayout title={restaurant.name}>
  <PublicMenu client:load restaurant={restaurant} menuData={menuData} slug={slug!} />
</BaseLayout>
