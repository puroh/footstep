---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="No encontrado">
  <div class="min-h-screen flex items-center justify-center bg-gray-50">
    <div class="text-center">
      <h1 class="text-6xl font-bold text-gray-300 mb-4">404</h1>
      <p class="text-xl text-gray-600 mb-6">Restaurante no encontrado</p>
      <p class="text-gray-500">El enlace que seguiste no corresponde a ningún restaurante activo.</p>
    </div>
  </div>
</BaseLayout>
